{
  "name": "lifeline_sentinel",
  "version": "1.0.0",
  "description": "Lifeline Sentinel is an intelligent suicide surveillance and forecasting system using Python, Flask, MySQL, and machine learning.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./app/static/css/src/input.css -o ./app/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./app/static/css/src/input.css -o ./app/static/css/app.css --watch",
    "copy:vendor": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/copy-vendor.ps1",
    "build": "npm run copy:vendor && npm run build:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "alpinejs": "^3.15.12",
    "chart.js": "^4.5.1",
    "datatables.net": "^2.3.8",
    "datatables.net-dt": "^2.3.8",
    "flowbite": "^4.0.2",
    "jquery": "^4.0.0",
    "select2": "^4.1.0-rc.0"
  }
}
